{
  "name": "hackcore-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:api": "pnpm run dev:backend",
    "dev:web": "pnpm run dev:frontend",
    "dev:mock": "pnpm --filter frontend dev:mock",
    "dev:real": "concurrently -n backend,frontend -c blue,magenta \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend exec drizzle-kit studio",
    "test:backend": "pnpm --filter backend test",
    "test:api": "pnpm run test:backend",
    "check:mock-leakage": "node scripts/check-mock-leakage.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msw"]
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^5.4.5"
  }
}
